rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product images are publicly readable, but only admins can write
    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.token.admin == true
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Invoices are private, but readable by the authenticated owner or admin
    match /invoices/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
